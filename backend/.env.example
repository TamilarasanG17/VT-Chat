# Copy this file to `.env` (same folder) and fill in the values. Never commit `.env`.

SERVER_PORT=8080

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=vtchat
DB_USERNAME=root
DB_PASSWORD=

# Frontend origin (CORS). Comma-separate several origins if needed.
CLIENT_URL=http://localhost:5173

# Resend (https://resend.com)
RESEND_API_KEY=
# Example: VTChat <onboarding@resend.dev>   (use your verified domain in production)
EMAIL_FROM=

# JWT. Generate each secret with:  openssl rand -base64 48   (min 32 characters, must differ)
JWT_SECRET=
# Access token lifetime in milliseconds (900000 = 15 minutes)
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_SECRET=
# Refresh token lifetime in milliseconds (604800000 = 7 days)
JWT_REFRESH_EXPIRATION=604800000

# Secret used to HMAC-hash OTPs before storing them. Generate with:  openssl rand -base64 32
OTP_SECRET=

# Phase 2: profile pictures. Files are saved under UPLOAD_DIR/avatars (relative to where you run the backend).
UPLOAD_DIR=./uploads
# Maximum profile picture size in MB
AVATAR_MAX_MB=2

# Phase 6: chat media (images, videos, files, voice messages), stored under MEDIA_UPLOAD_DIR/{images,videos,files,voice}.
# Defaults to UPLOAD_DIR. Never publish this folder through a web server: files are served only by the authenticated API.
MEDIA_UPLOAD_DIR=./uploads
# Size limits in MEGABYTES per type
MAX_IMAGE_SIZE=10
MAX_VIDEO_SIZE=50
MAX_FILE_SIZE=25
MAX_VOICE_SIZE=10
# Hard ceiling for a single upload request in MB. Keep it >= the largest MAX_*_SIZE above.
MAX_UPLOAD_REQUEST_MB=100

# Refresh-token cookie. In production (HTTPS): COOKIE_SECURE=true.
# If frontend and backend are on different sites use COOKIE_SAME_SITE=None (requires COOKIE_SECURE=true).
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

# Phase 7: message translation. Spring Boot calls the internal Python translation service (see translation-service/README.md).
TRANSLATION_SERVICE_URL=http://localhost:8001
# Must match TRANSLATION_SERVICE_API_KEY in translation-service/.env. Keep it server-side only.
TRANSLATION_SERVICE_API_KEY=change-me-long-random-string
# Read timeout in milliseconds
TRANSLATION_SERVICE_TIMEOUT_MS=10000

# Phase 8: voice / video calls. Audio and video travel browser-to-browser (WebRTC); the server only relays signaling.
# Seconds an unanswered call rings before it becomes MISSED (CALL_RING_TIMEOUT_SECONDS is accepted as an alias)
CALL_RING_TIMEOUT=30
# Seconds allowed to establish the connection after the receiver accepts
CALL_CONNECT_TIMEOUT_SECONDS=45
# A user whose signaling connection stays closed this long has their active call ended
CALL_DISCONNECT_GRACE_SECONDS=15
# STUN server given to browsers
STUN_SERVER=stun:stun.l.google.com:19302
# Optional but recommended in production: a TURN relay for users behind strict NAT / firewalls.
# TURN_SERVER_URLS: comma separated, e.g. turn:turn.example.com:3478,turns:turn.example.com:5349
TURN_SERVER_URLS=
# The TURN server's shared secret (coturn: use-auth-secret + static-auth-secret). It is NEVER sent to browsers:
# the backend signs short-lived, per-user credentials from it (GET /api/calls/ice-servers).
TURN_SHARED_SECRET=
TURN_CREDENTIAL_TTL_SECONDS=3600

# Phase 8.5: presence / typing
# A user is shown offline only after ALL their connections have been gone this many seconds (hides page refreshes)
PRESENCE_OFFLINE_GRACE_SECONDS=5
# "typing..." not refreshed by the sender within this many seconds is cleared by the server
TYPING_TTL_SECONDS=7

# Phase 10: Redis, multiple backend instances, rate limiting.
# Redis connection. Local Redis and production Redis differ only in these values. Never expose Redis publicly.
REDIS_HOST=localhost
REDIS_PORT=6379
# Required in production (also configure `requirepass` / ACL on the Redis server). Empty = no password (local dev only).
REDIS_PASSWORD=
REDIS_DATABASE=0
# false = run without Redis (single instance): caches, Pub/Sub and shared sessions fall back to local behaviour
REDIS_ENABLED=true
REDIS_CACHE_TTL_SECONDS=300
# A unique name per running backend instance (instance-1, instance-2, ...)
WEBSOCKET_INSTANCE_ID=instance-1
# SERVER_PORT=9090   # give every instance on the same machine its own port

RATE_LIMIT_ENABLED=true
# Only behind your own load balancer: trust the last X-Forwarded-For entry as the client IP
RATE_LIMIT_TRUST_FORWARDED_HEADERS=false
# Requests per window (windows are in application.yml and can be overridden with *_RATE_WINDOW_SECONDS). 0 = off.
AUTH_RATE_LIMIT=10
OTP_RATE_LIMIT=20
SEARCH_RATE_LIMIT=30
MESSAGE_RATE_LIMIT=60
MEDIA_RATE_LIMIT=20
TRANSLATION_RATE_LIMIT=20
CALL_SIGNAL_RATE_LIMIT=60

# Phase 11: AI assistant. Spring Boot calls the internal Python AI service (see ai-service/README.md).
# The LLM key/provider/model are configured ONLY in ai-service/.env; the browser never sees any of this.
AI_SERVICE_URL=http://localhost:8002
# Must match AI_SERVICE_API_KEY in ai-service/.env. Generate with:  openssl rand -base64 48
AI_SERVICE_API_KEY=change-me-long-random-string
# Read timeout in milliseconds (first byte / between streamed chunks). Keep >= LLM_TIMEOUT_MS of the AI service.
AI_SERVICE_TIMEOUT_MS=30000
# Per-user AI requests per window (the LLM costs money)
AI_RATE_LIMIT=20
AI_RATE_LIMIT_WINDOW_SECONDS=60
# Largest single AI message (characters) and how many earlier messages of the same AI chat are sent as context
AI_MAX_MESSAGE_LENGTH=4000
AI_MAX_CONTEXT_MESSAGES=20
AI_MAX_CONVERSATIONS_PER_USER=100
AI_STREAM_MAX_MS=120000

# ---- Phase 12: My Knowledge (RAG) ----
# Documents are stored by Spring Boot; the Python AI service extracts, embeds and searches them in Qdrant.
# Chunking / embedding / retrieval settings (RAG_CHUNK_SIZE, RAG_TOP_K, EMBEDDING_*, QDRANT_*) live in ai-service/.env.
RAG_ENABLED=true
RAG_MAX_DOCUMENT_SIZE_MB=20
RAG_MAX_DOCUMENTS_PER_USER=50
RAG_MAX_QUERY_LENGTH=2000
# Read timeout (ms) of the document processing call (embedding a big document takes a while)
RAG_PROCESS_TIMEOUT_MS=600000
RAG_STUCK_AFTER_MINUTES=20
RAG_PROCESSING_THREADS=2
# Per-user limits (Redis, Phase 10). Each is its own bucket.
RAG_UPLOAD_RATE_LIMIT=5
RAG_REPROCESS_RATE_LIMIT=5
RAG_QUERY_RATE_LIMIT=20
# Keep MAX_UPLOAD_REQUEST_MB (above) >= RAG_MAX_DOCUMENT_SIZE_MB


# ---- Media storage: local disk (development) or Cloudinary (production) ----
# local = files under MEDIA_LOCAL_ROOT (default ./uploads). Needs no account.
# cloudinary = production. If it is selected and anything below is missing, the app refuses to start (it never falls
# back to local silently). Provide the values as real environment variables on the host; never commit them.
MEDIA_STORAGE_PROVIDER=local
MEDIA_LOCAL_ROOT=uploads
# prod profile only: set true to deliberately keep using local disk in production (not recommended)
MEDIA_ALLOW_LOCAL_IN_PRODUCTION=false

# Required when MEDIA_STORAGE_PROVIDER=cloudinary (Cloudinary Console > Settings > API Keys). Server side only:
# never put these in the frontend or in a VITE_* variable.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Root folder of everything this app stores. Do not change it after go-live.
CLOUDINARY_FOLDER=vtchat
# Optional tuning (milliseconds)
CLOUDINARY_API_TIMEOUT_MS=20000
CLOUDINARY_UPLOAD_TIMEOUT_MS=300000
CLOUDINARY_DOWNLOAD_TIMEOUT_MS=60000
CLOUDINARY_CONNECT_TIMEOUT_MS=5000
CLOUDINARY_VERIFY_ON_STARTUP=true

# ---- Optional migrations of OLD local files to Cloudinary (off by default; see README) ----
MEDIA_MIGRATION_ENABLED=false
MEDIA_MIGRATION_DRY_RUN=true
MEDIA_MIGRATION_RETRY_FAILED=false
MEDIA_MIGRATION_LIMIT=0
MEDIA_MIGRATION_EXIT_WHEN_DONE=true
AVATAR_MIGRATION_ENABLED=false
AVATAR_MIGRATION_DRY_RUN=true
AVATAR_MIGRATION_RETRY_FAILED=false
AVATAR_MIGRATION_LIMIT=0
AVATAR_MIGRATION_EXIT_WHEN_DONE=true
