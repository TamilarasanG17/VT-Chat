# Copy to `.env` (same folder). Never commit `.env`. Everything here stays on the server: the browser never sees it.

AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8002
# Shared secret between Spring Boot and this service. Must equal AI_SERVICE_API_KEY in backend/.env.
# Generate with:  openssl rand -base64 48
AI_SERVICE_API_KEY=

# ---- LLM provider (change these to switch models; the React app and Spring Boot are not touched) ----
# openai | anthropic | groq | openrouter | gemini | ollama | openai-compatible | mock
#   openai, groq, openrouter, gemini, ollama, openai-compatible all speak the OpenAI "chat completions" protocol.
#   mock needs no key and no network (answers with a canned reply): use it to try the whole app first.
LLM_PROVIDER=mock
LLM_MODEL=
LLM_API_KEY=
# Optional. Each provider has a default; set it for openai-compatible (vLLM, LM Studio, a gateway, ...) or a proxy.
LLM_BASE_URL=

# Time to wait for the provider: connect/first byte and between streamed chunks (milliseconds)
LLM_TIMEOUT_MS=30000
# Hard cap for one whole streamed answer (milliseconds)
AI_STREAM_MAX_MS=120000
# Maximum tokens the model may generate per answer (cost protection). 0 = do not send a limit (not allowed for anthropic).
LLM_MAX_OUTPUT_TOKENS=1024
LLM_TEMPERATURE=0.3

# ---- Limits (cost protection) ----
# History messages kept (newest first) before the new message is added
AI_MAX_CONTEXT_MESSAGES=20
# Characters allowed in ONE user message
AI_MAX_MESSAGE_LENGTH=4000
# Total characters (history + new message) sent to the model
AI_MAX_CONTEXT_CHARS=24000

# ---- System prompt (server-side only; clients cannot change it) ----
# Leave both empty to use the built-in prompt. AI_SYSTEM_PROMPT_FILE wins over AI_SYSTEM_PROMPT.
AI_SYSTEM_PROMPT=
AI_SYSTEM_PROMPT_FILE=

# =====================================================================================
# ---- Phase 12: RAG (documents -> embeddings -> Qdrant -> grounded answers) ----
# =====================================================================================
RAG_ENABLED=true

# Qdrant vector database (never exposed to the browser). Docker: see ../docker-compose.yml
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=vtchat_documents
QDRANT_TIMEOUT_MS=10000

# Dedicated EMBEDDING model (never the chat LLM).
#   mock               no download, no network; keyword-like, NOT semantic. Good for trying the plumbing only.
#   local              sentence-transformers inside this service (pip install -r requirements-embeddings.txt)
#   openai-compatible  any /v1/embeddings endpoint (OpenAI, vLLM, TEI, Ollama, ...)
EMBEDDING_PROVIDER=mock
# Multilingual (English, Tamil, Hindi, ...). Changing the model => change EMBEDDING_DIMENSION and use a NEW collection
# (or re-process all documents); a collection with a different size is refused at startup.
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIMENSION=384
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
# e5 models need "query: " / "passage: " prefixes. Leave UNSET to get that automatically for model names containing "e5"
# (and none otherwise); set explicitly to override.
EMBEDDING_QUERY_PREFIX=
EMBEDDING_PASSAGE_PREFIX=
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_MS=30000

# Chunking (characters)
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_MIN_CHUNK_CHARS=40

# Retrieval
RAG_TOP_K=5
RAG_MAX_CONTEXT_CHUNKS=5
RAG_MAX_CONTEXT_CHARS=8000
# Optional minimum cosine score. Empty = 0.15 for mock, 0 for real models. TUNE for your model.
RAG_SIMILARITY_THRESHOLD=
RAG_MAX_QUERY_LENGTH=2000

# Ingestion limits
RAG_MAX_DOCUMENT_MB=50
RAG_MAX_PAGES=1000
RAG_MAX_DOCUMENT_CHARS=3000000
RAG_MAX_CONCURRENT_INGEST=2

# Optional override of the grounded-answer system prompt (server-side only)
RAG_SYSTEM_PROMPT=
