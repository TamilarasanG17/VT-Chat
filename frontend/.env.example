VITE_API_URL=http://localhost:8080/api

# Optional (Phase 6): client-side size hints. The server limits (backend MAX_*_SIZE) are the real ones.
# VITE_MAX_IMAGE_MB=10
# VITE_MAX_VIDEO_MB=50
# VITE_MAX_FILE_MB=25
# VITE_MAX_VOICE_MB=10

# Phase 8 (voice + video calls) - WebRTC ICE servers.
# The app first asks the backend (GET /api/calls/ice-servers) for STUN + short-lived TURN credentials; the values
# below are the FALLBACK (local development, or when that request fails).
# WARNING: VITE_* values are baked into the public JavaScript. Never put a production TURN secret here - keep
# TURN_SHARED_SECRET on the backend only and let it issue per-user, expiring credentials.
VITE_STUN_SERVER=stun:stun.l.google.com:19302
# VITE_TURN_SERVER=turn:turn.example.com:3478
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=

# Phase 8.5: milliseconds of no typing before "stopped typing" is sent (clamped to 1500-3000)
# VITE_TYPING_IDLE_MS=2500

# Phase 12 (hints only; the server enforces the real limits)
VITE_RAG_MAX_DOCUMENT_SIZE_MB=20
VITE_RAG_MAX_QUERY_LENGTH=2000

