TRANSLATION_SERVICE_HOST=0.0.0.0
TRANSLATION_SERVICE_PORT=8001
# Shared secret; Spring sends it in the X-Internal-Api-Key header. The service refuses to start without it.
TRANSLATION_SERVICE_API_KEY=change-me-long-random-string
# Optional: one checkpoint for every direction. Leave empty to use the three distilled checkpoints below.
INDICTRANS2_MODEL=
INDICTRANS2_MODEL_EN_INDIC=ai4bharat/indictrans2-en-indic-dist-200M
INDICTRANS2_MODEL_INDIC_EN=ai4bharat/indictrans2-indic-en-dist-200M
INDICTRANS2_MODEL_INDIC_INDIC=ai4bharat/indictrans2-indic-indic-dist-320M
# auto | cpu | cuda
INDICTRANS2_DEVICE=auto
